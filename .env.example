# LLM Provider
GROQ_API_KEY=your_groq_api_key_here

# App Settings
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=30

# Vector DB
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=banglalaw

# Scraper
SCRAPER_BASE_URL=http://bdlaws.minlaw.gov.bd
SCRAPER_DELAY_SECONDS=2

# MLflow (DagsHub)
MLFLOW_TRACKING_URI=your_dagshub_mlflow_uri_here
MLFLOW_EXPERIMENT_NAME=banglalaw-eval

# Data Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
